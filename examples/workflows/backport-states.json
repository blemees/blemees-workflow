{
  "$schema": "../../docs/schemas/states.schema.json",
  "states": {
    "ready_for_backport": {
      "class": "resting",
      "reversibility": "reversible-slow"
    },
    "cherry_picking": {
      "class": "working",
      "roles": ["developer"],
      "issue_types": ["backport"]
    },
    "backport_pr_review": {
      "class": "resting",
      "reversibility": "reversible-fast"
    },
    "backport_merged": {
      "class": "resting",
      "reversibility": "reversible-slow"
    },
    "patch_releasing": {
      "class": "resting",
      "reversibility": "reversible-slow"
    },
    "backported": {
      "class": "terminal",
      "reversibility": "reversible-slow",
      "terminal_taxonomy": "shipped",
      "close_reason": "completed"
    }
  },
  "transitions": [
    {"source": "ready_for_backport", "destination": "cherry_picking", "type": "claim", "label": "developer claims backport"},
    {"source": "cherry_picking", "destination": "backport_pr_review", "type": "advance", "label": "developer opens backport PR (spawns PR on process pr-review)"},
    {"source": "backport_pr_review", "destination": "backport_merged", "type": "event", "label": "from process pr-review (backport PR merged to release branch)"},
    {"source": "backport_merged", "destination": "patch_releasing", "type": "event", "label": "patch release triggered (spawns patch train on process release, IC bypass of release gate)"},
    {"source": "patch_releasing", "destination": "backported", "type": "event", "label": "from process release (patch deployed to production)"}
  ]
}
