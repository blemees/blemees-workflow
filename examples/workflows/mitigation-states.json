{
  "$schema": "../../docs/schemas/states.schema.json",
  "group": "incident",
  "description": "Plan and execute a mitigation strategy during an active incident. The responder drafts a plan, then dispatches one or more sub-mitigations \u2014 a hotfix, a configuration change, a data change, or any combination \u2014 each as a child issue on its own process. `execute_mitigation` declares a multi-spawn rule per mitigation type; the wait-for-all cascade closes this issue at `mitigated` only when every spawned child reaches its respective applied / shipped terminal, which in turn cascades the parent incident to `needs_verification`.",
  "states": {
    "ready_for_mitigation": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "issue_types": [
        "incident-mitigation"
      ]
    },
    "plan_mitigation": {
      "class": "working",
      "roles": [
        "incident-responder"
      ],
      "issue_types": [
        "incident-mitigation"
      ],
      "human_inputs": [
        "clarify-scope",
        "needs-arch-review",
        "needs-security-review",
        "blocked-on-data",
        "general"
      ]
    },
    "mitigation_planned": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "issue_types": [
        "incident-mitigation"
      ]
    },
    "execute_mitigation": {
      "class": "working",
      "roles": [
        "incident-responder"
      ],
      "issue_types": [
        "incident-mitigation"
      ],
      "human_inputs": [
        "clarify-scope",
        "general"
      ],
      "spawns": [
        {
          "issue_type": "hotfix",
          "initial_state": "ready_for_hotfix",
          "advance_on": {
            "shipped": "mitigated"
          }
        },
        {
          "issue_type": "config-change",
          "initial_state": "ready_for_config_change",
          "advance_on": {
            "config_applied": "mitigated"
          }
        },
        {
          "issue_type": "data-change",
          "initial_state": "ready_for_data_change",
          "advance_on": {
            "data_change_applied": "mitigated"
          }
        }
      ]
    },
    "mitigated": {
      "class": "resting",
      "reversibility": "reversible-slow",
      "closes": {
        "taxonomy": "shipped",
        "reason": "completed"
      }
    }
  },
  "transitions": [
    {
      "source": "ready_for_mitigation",
      "destination": "plan_mitigation",
      "type": "claim",
      "label": "responder claims to plan mitigation"
    },
    {
      "source": "plan_mitigation",
      "destination": "mitigation_planned",
      "type": "advance",
      "label": "responder finalizes mitigation plan"
    },
    {
      "source": "mitigation_planned",
      "destination": "execute_mitigation",
      "type": "claim",
      "label": "responder claims to execute mitigation"
    },
    {
      "source": "execute_mitigation",
      "destination": "mitigated",
      "type": "advance",
      "label": "all spawned mitigations complete (auto via wait-for-all cascade)"
    }
  ]
}
