{
  "$schema": "../../docs/schemas/states.schema.json",
  "description": "Roll back or feature-flag-off shipped behavior to stop bleeding during an active incident. Branches off incident-response when a revert is the right call.",
  "states": {
    "ready_for_mitigation": {
      "class": "resting",
      "reversibility": "reversible-fast"
    },
    "ready_for_hotfix": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "handoff": true
    },
    "applying_mitigation": {
      "class": "working",
      "roles": [
        "incident-responder"
      ],
      "issue_types": [
        "incident"
      ]
    },
    "mitigated": {
      "class": "terminal",
      "reversibility": "reversible-slow",
      "terminal_taxonomy": "shipped",
      "close_reason": "completed"
    }
  },
  "transitions": [
    {
      "source": "ready_for_mitigation",
      "destination": "applying_mitigation",
      "type": "claim",
      "label": "responder claims mitigation (rollback or flag-toggle)"
    },
    {
      "source": "applying_mitigation",
      "destination": "mitigated",
      "type": "advance",
      "label": "responder completes mitigation"
    }
  ]
}
