{
  "$schema": "../../docs/schemas/states.schema.json",
  "name": "mitigation",
  "states": {
    "ready_for_rollback": {
      "class": "resting",
      "reversibility": "reversible-fast"
    },
    "ready_for_flag_toggle": {
      "class": "resting",
      "reversibility": "reversible-fast"
    },
    "ready_for_hotfix": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "handoff": true
    },
    "rolling_back": {
      "class": "working",
      "roles": ["incident-responder"],
      "issue_types": ["incident"]
    },
    "rolled_back": {
      "class": "terminal",
      "reversibility": "reversible-slow",
      "terminal_taxonomy": "shipped",
      "close_reason": "completed"
    },
    "toggling_flag": {
      "class": "working",
      "roles": ["incident-responder"],
      "issue_types": ["incident"]
    },
    "flag_toggled": {
      "class": "terminal",
      "reversibility": "reversible-slow",
      "terminal_taxonomy": "shipped",
      "close_reason": "completed"
    }
  },
  "transitions": [
    {"source": "ready_for_rollback", "destination": "rolling_back", "type": "claim", "label": "responder claims rollback"},
    {"source": "rolling_back", "destination": "rolled_back", "type": "advance", "label": "responder completes rollback"},
    {"source": "ready_for_flag_toggle", "destination": "toggling_flag", "type": "claim", "label": "responder claims flag toggle"},
    {"source": "toggling_flag", "destination": "flag_toggled", "type": "advance", "label": "responder completes toggle"}
  ]
}
