{
  "name": "experimentation",
  "canonical_catalog_path": "experimentation-hcps.json",
  "issue_types": ["experiment"],
  "states": {
    "measuring": {
      "class": "resting"
    },
    "measurement_complete": {
      "class": "resting",
      "claim_role": "product-owner"
    },
    "analyzing": {
      "class": "working"
    },
    "aborting": {
      "class": "working"
    },
    "promoted": {
      "class": "terminal",
      "reversibility": "reversible-slow",
      "terminal_taxonomy": "shipped",
      "close_reason": "completed"
    },
    "killed": {
      "class": "terminal",
      "reversibility": "reversible-slow",
      "terminal_taxonomy": "abandoned",
      "close_reason": "not planned"
    },
    "iterated": {
      "class": "terminal",
      "reversibility": "reversible-fast",
      "terminal_taxonomy": "iterated",
      "close_reason": "not planned"
    },
    "aborted": {
      "class": "terminal",
      "reversibility": "reversible-fast",
      "terminal_taxonomy": "aborted",
      "close_reason": "not planned"
    }
  },
  "transitions": [
    {"source": "[*]", "destination": "measuring", "type": "cross_process", "label": "from process release (experiment released to production)", "kind": "spawn", "process": "release"},

    {"source": "measuring", "destination": "measurement_complete", "type": "external", "label": "measurement window elapses (time)"},
    {"source": "measuring", "destination": "aborting", "type": "claim", "label": "PO claims to abort"},

    {"source": "aborting", "destination": "aborted", "type": "role_action", "label": "PO publishes abort reason"},

    {"source": "measurement_complete", "destination": "analyzing", "type": "claim", "label": "PO claims experiment for analysis"},

    {"source": "analyzing", "destination": "measuring", "type": "role_action", "label": "PO extends experiment, resets window"},
    {"source": "analyzing", "destination": "promoted", "type": "role_action", "label": "PO promotes experiment to feature (files promotion chore on process refinement)"},
    {"source": "analyzing", "destination": "killed", "type": "role_action", "label": "PO kills experiment (files cleanup chore on process refinement)"},
    {"source": "analyzing", "destination": "iterated", "type": "role_action", "label": "PO requests experiment iteration (files new experiment on process refinement)"}
  ]
}
