{
  "$schema": "../../docs/schemas/states.schema.json",
  "name": "experimentation",
  "states": {
    "measuring": {
      "class": "resting",
      "reversibility": "reversible-slow"
    },
    "measurement_complete": {
      "class": "resting",
      "reversibility": "reversible-fast"
    },
    "analyzing": {
      "class": "working",
      "roles": ["product-owner"],
      "issue_types": ["experiment"]
    },
    "aborting": {
      "class": "working",
      "issue_types": ["experiment"],
      "roles": ["product-owner"]
    },
    "promoted": {
      "class": "terminal",
      "reversibility": "reversible-slow",
      "terminal_taxonomy": "shipped",
      "close_reason": "completed"
    },
    "killed": {
      "class": "terminal",
      "reversibility": "reversible-slow",
      "terminal_taxonomy": "abandoned",
      "close_reason": "not planned"
    },
    "iterated": {
      "class": "terminal",
      "reversibility": "reversible-fast",
      "terminal_taxonomy": "superseded",
      "close_reason": "not planned"
    },
    "aborted": {
      "class": "terminal",
      "reversibility": "reversible-fast",
      "terminal_taxonomy": "abandoned",
      "close_reason": "not planned"
    }
  },
  "transitions": [
    {"source": "measuring", "destination": "measurement_complete", "type": "event", "label": "measurement window elapses (time)"},
    {"source": "measuring", "destination": "aborting", "type": "claim", "label": "PO claims to abort"},
    {"source": "aborting", "destination": "aborted", "type": "advance", "label": "PO publishes abort reason"},
    {"source": "measurement_complete", "destination": "analyzing", "type": "claim", "label": "PO claims experiment for analysis"},
    {"source": "analyzing", "destination": "measuring", "type": "advance", "label": "PO extends experiment, resets window"},
    {"source": "analyzing", "destination": "promoted", "type": "advance", "label": "PO promotes experiment to feature (files promotion chore on process refinement)"},
    {"source": "analyzing", "destination": "killed", "type": "advance", "label": "PO kills experiment (files cleanup chore on process refinement)"},
    {"source": "analyzing", "destination": "iterated", "type": "advance", "label": "PO requests experiment iteration (files new experiment on process refinement)"}
  ]
}
