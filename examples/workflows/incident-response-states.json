{
  "$schema": "../../docs/schemas/states.schema.json",
  "description": "Coordinate the live response to a production incident: declare, mitigate, stabilize. Spawns a postmortem on stabilization.",
  "states": {
    "declared": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "initial": "alert / report triggers incident (external)",
      "issue_types": [
        "incident"
      ]
    },
    "triaging": {
      "class": "working",
      "roles": [
        "incident-commander"
      ],
      "issue_types": [
        "incident"
      ]
    },
    "needs_diagnosis": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "issue_types": [
        "incident"
      ]
    },
    "diagnosing": {
      "class": "working",
      "roles": [
        "incident-responder"
      ],
      "issue_types": [
        "incident"
      ],
      "human_inputs": [
        "blocked-on-data",
        "general"
      ]
    },
    "cause_identified": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "issue_types": [
        "incident"
      ]
    },
    "mitigating": {
      "class": "working",
      "roles": [
        "incident-commander"
      ],
      "issue_types": [
        "incident"
      ],
      "human_inputs": [
        "needs-security-review",
        "blocked-on-data",
        "general"
      ],
      "spawns": {
        "process": "mitigation",
        "issue_type": "incident-mitigation",
        "initial_state": "ready_for_mitigation",
        "advance_on": {
          "mitigated": "needs_verification"
        }
      }
    },
    "needs_verification": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "issue_types": [
        "incident"
      ]
    },
    "verifying": {
      "class": "working",
      "roles": [
        "incident-responder"
      ],
      "issue_types": [
        "incident"
      ]
    },
    "stabilized": {
      "class": "terminal",
      "reversibility": "reversible-fast",
      "terminal_taxonomy": "superseded",
      "close_reason": "completed",
      "spawns": {
        "process": "postmortem",
        "issue_type": "postmortem",
        "initial_state": "pending"
      }
    }
  },
  "transitions": [
    {
      "source": "declared",
      "destination": "triaging",
      "type": "claim",
      "label": "IC claims incident"
    },
    {
      "source": "triaging",
      "destination": "needs_diagnosis",
      "type": "advance",
      "label": "IC assigns severity, assigns responder"
    },
    {
      "source": "needs_diagnosis",
      "destination": "diagnosing",
      "type": "claim",
      "label": "responder claims diagnosis"
    },
    {
      "source": "diagnosing",
      "destination": "cause_identified",
      "type": "advance",
      "label": "responder reports root cause"
    },
    {
      "source": "cause_identified",
      "destination": "mitigating",
      "type": "claim",
      "label": "IC claims incident for mitigation"
    },
    {
      "source": "mitigating",
      "destination": "needs_verification",
      "type": "advance",
      "label": "IC requests verification (spawns work items on process mitigation)"
    },
    {
      "source": "needs_verification",
      "destination": "verifying",
      "type": "claim",
      "label": "responder claims verification"
    },
    {
      "source": "verifying",
      "destination": "cause_identified",
      "type": "advance",
      "label": "responder reports mitigation failed"
    },
    {
      "source": "verifying",
      "destination": "stabilized",
      "type": "advance",
      "label": "responder confirms production stable (spawns postmortem on process postmortem)"
    }
  ]
}
