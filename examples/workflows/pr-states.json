{
  "$schema": "../../docs/schemas/states.schema.json",
  "group": "delivery",
  "description": "The pull-request lifecycle: draft → review → merged. Spawned from inner-loop's implementing state.",
  "states": {
    "draft": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "issue_types": [
        "pr"
      ]
    },
    "drafting": {
      "class": "working",
      "roles": [
        "developer"
      ],
      "issue_types": [
        "pr"
      ]
    },
    "needs_review": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "mark_pr_ready": true,
      "issue_types": [
        "pr"
      ]
    },
    "reviewing": {
      "class": "working",
      "roles": [
        "peer-reviewer"
      ],
      "issue_types": [
        "pr"
      ],
      "human_inputs": [
        "needs-security-review",
        "general"
      ]
    },
    "changes_requested": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "issue_types": [
        "pr"
      ]
    },
    "fixing_review": {
      "class": "working",
      "roles": [
        "developer"
      ],
      "issue_types": [
        "pr"
      ],
      "human_inputs": [
        "clarify-scope",
        "general"
      ]
    },
    "needs_qa": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "issue_types": [
        "pr"
      ]
    },
    "verifying": {
      "class": "working",
      "roles": [
        "tester"
      ],
      "issue_types": [
        "pr"
      ]
    },
    "qa_passed": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "issue_types": [
        "pr"
      ]
    },
    "qa_failed": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "issue_types": [
        "pr"
      ]
    },
    "fixing_qa": {
      "class": "working",
      "roles": [
        "developer"
      ],
      "issue_types": [
        "pr"
      ]
    },
    "merging": {
      "class": "working",
      "roles": [
        "developer"
      ],
      "issue_types": [
        "pr"
      ]
    },
    "merged": {
      "class": "terminal",
      "reversibility": "reversible-slow",
      "terminal_taxonomy": "shipped",
      "close_reason": "completed"
    }
  },
  "transitions": [
    {
      "source": "draft",
      "destination": "drafting",
      "type": "claim",
      "label": "developer claims draft"
    },
    {
      "source": "drafting",
      "destination": "needs_review",
      "type": "advance",
      "label": "developer marks PR ready for review"
    },
    {
      "source": "needs_review",
      "destination": "reviewing",
      "type": "claim",
      "label": "reviewer claims PR"
    },
    {
      "source": "reviewing",
      "destination": "needs_qa",
      "type": "advance",
      "label": "reviewer approves PR"
    },
    {
      "source": "reviewing",
      "destination": "qa_passed",
      "type": "advance",
      "label": "reviewer approves hotfix PR (QA skipped, IC discretion)"
    },
    {
      "source": "reviewing",
      "destination": "changes_requested",
      "type": "advance",
      "label": "reviewer requests changes"
    },
    {
      "source": "changes_requested",
      "destination": "fixing_review",
      "type": "claim",
      "label": "developer claims PR for fixes"
    },
    {
      "source": "fixing_review",
      "destination": "needs_review",
      "type": "advance",
      "label": "developer re-requests review"
    },
    {
      "source": "needs_qa",
      "destination": "verifying",
      "type": "claim",
      "label": "QA claims PR"
    },
    {
      "source": "verifying",
      "destination": "qa_passed",
      "type": "advance",
      "label": "QA posts pass verdict"
    },
    {
      "source": "verifying",
      "destination": "qa_failed",
      "type": "advance",
      "label": "QA posts fail verdict"
    },
    {
      "source": "qa_failed",
      "destination": "fixing_qa",
      "type": "claim",
      "label": "developer claims PR for fixes"
    },
    {
      "source": "fixing_qa",
      "destination": "needs_review",
      "type": "advance",
      "label": "developer re-requests review"
    },
    {
      "source": "qa_passed",
      "destination": "merging",
      "type": "claim",
      "label": "developer claims and merges"
    },
    {
      "source": "merging",
      "destination": "merged",
      "type": "advance",
      "label": "verified staging deploy"
    },
    {
      "source": "merging",
      "destination": "needs_review",
      "type": "advance",
      "label": "merge conflict or failed staging deploy"
    }
  ]
}
