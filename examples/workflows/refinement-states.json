{
  "$schema": "../../docs/schemas/states.schema.json",
  "states": {
    "raw": {
      "class": "resting",
      "reversibility": "reversible-fast"
    },
    "refining": {
      "class": "working",
      "roles": ["product-manager"],
      "issue_types": ["bug", "feature", "chore", "experiment"],
      "human_inputs": ["clarify-scope", "needs-arch-review", "needs-security-review", "needs-ux-input", "general"]
    },
    "consult_requested": {
      "class": "resting",
      "reversibility": "reversible-fast"
    },
    "consulting": {
      "class": "working",
      "issue_types": ["bug", "feature", "chore", "experiment"],
      "roles": ["architect", "designer", "security-engineer"],
      "human_inputs": ["needs-arch-review", "needs-security-review", "general"]
    },
    "consult_complete": {
      "class": "resting",
      "reversibility": "reversible-fast"
    },
    "spiking": {
      "class": "resting",
      "reversibility": "reversible-fast"
    },
    "ready_for_dev": {
      "class": "resting",
      "reversibility": "reversible-slow",
      "handoff": true
    },
    "ready_for_experiment": {
      "class": "resting",
      "reversibility": "reversible-slow",
      "handoff": true
    },
    "ready_bounced": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "handoff": true
    },
    "deprioritized": {
      "class": "resting",
      "reversibility": "reversible-fast"
    },
    "duplicate": {
      "class": "terminal",
      "reversibility": "reversible-fast",
      "terminal_taxonomy": "deduplicated",
      "close_reason": "not planned"
    },
    "wont_fix": {
      "class": "terminal",
      "reversibility": "reversible-fast",
      "terminal_taxonomy": "abandoned",
      "close_reason": "not planned"
    }
  },
  "transitions": [
    {"source": "[*]", "destination": "raw", "type": "event", "label": "issue created (external)"},
    {"source": "raw", "destination": "refining", "type": "claim", "label": "PM claims raw"},
    {"source": "refining", "destination": "duplicate", "type": "advance", "label": "PM marks duplicate"},
    {"source": "refining", "destination": "wont_fix", "type": "advance", "label": "PM marks won't-fix"},
    {"source": "refining", "destination": "consult_requested", "type": "advance", "label": "PM requests consult"},
    {"source": "consult_requested", "destination": "consulting", "type": "claim", "label": "consultant claims consult"},
    {"source": "consulting", "destination": "consult_complete", "type": "advance", "label": "consultant posts findings"},
    {"source": "consult_complete", "destination": "refining", "type": "claim", "label": "PM claims consult feedback"},
    {"source": "consulting", "destination": "spiking", "type": "advance", "label": "consultant creates spike sub-issue (spawns spike to inner-loop ready_for_spike)"},
    {"source": "spiking", "destination": "consulting", "type": "claim", "label": "consultant claims spike findings"},
    {"source": "refining", "destination": "ready_for_dev", "type": "advance", "label": "PM marks ready (feat/bug/chore)"},
    {"source": "refining", "destination": "ready_for_experiment", "type": "advance", "label": "PM marks ready (exp)"},
    {"source": "ready_bounced", "destination": "refining", "type": "claim", "label": "PM claims bounced issue"},
    {"source": "refining", "destination": "deprioritized", "type": "advance", "label": "PM parks issue"},
    {"source": "ready_for_dev", "destination": "deprioritized", "type": "advance", "label": "PM parks issue"},
    {"source": "ready_for_experiment", "destination": "deprioritized", "type": "advance", "label": "PM parks issue"},
    {"source": "deprioritized", "destination": "refining", "type": "claim", "label": "PM claims to re-refine (staleness check)"},
    {"source": "deprioritized", "destination": "wont_fix", "type": "advance", "label": "PM kills parked issue"}
  ]
}
