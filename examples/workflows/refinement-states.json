{
  "$schema": "../../docs/schemas/states.schema.json",
  "group": "delivery",
  "description": "Shape raw ideas and bug reports into ready-for-dev tickets. The product manager owns the queue, classifies issue type, and either marks ready or parks/kills. Chores skip this process and are filed directly on `inner-loop.ready_for_dev` \u2014 engineering hygiene work doesn't need PM refinement.",
  "states": {
    "raw": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "initial": "issue created (external)",
      "issue_types": [
        "bug",
        "feature",
        "experiment"
      ]
    },
    "refining": {
      "class": "working",
      "roles": [
        "product-manager"
      ],
      "issue_types": [
        "bug",
        "feature",
        "experiment"
      ],
      "human_inputs": [
        "clarify-scope",
        "needs-arch-review",
        "needs-security-review",
        "needs-ux-input",
        "blocked-on-data",
        "general"
      ]
    },
    "consult_requested": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "issue_types": [
        "bug",
        "feature",
        "experiment"
      ]
    },
    "consulting": {
      "class": "working",
      "issue_types": [
        "bug",
        "feature",
        "experiment"
      ],
      "roles": [
        "architect",
        "designer",
        "security-engineer"
      ],
      "human_inputs": [
        "clarify-scope",
        "needs-arch-review",
        "needs-security-review",
        "needs-ux-input",
        "blocked-on-data",
        "general"
      ]
    },
    "consult_complete": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "issue_types": [
        "bug",
        "feature",
        "experiment"
      ]
    },
    "spiking": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "issue_types": [
        "bug",
        "feature",
        "experiment"
      ],
      "spawns": {
        "process": "inner-loop",
        "issue_type": "spike",
        "initial_state": "ready_for_spike",
        "advance_on": {
          "spike_completed": "spike_returned"
        }
      }
    },
    "spike_returned": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "issue_types": [
        "bug",
        "feature",
        "experiment"
      ]
    },
    "ready_for_dev": {
      "class": "resting",
      "reversibility": "reversible-slow",
      "handoff": true,
      "issue_types": [
        "bug",
        "feature",
        "experiment"
      ]
    },
    "ready_bounced": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "handoff": true,
      "issue_types": [
        "bug",
        "feature",
        "experiment"
      ]
    },
    "deprioritized": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "issue_types": [
        "bug",
        "feature",
        "experiment"
      ]
    },
    "duplicate": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "closes": {
        "taxonomy": "deduplicated",
        "reason": "not planned"
      }
    },
    "wont_fix": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "closes": {
        "taxonomy": "abandoned",
        "reason": "not planned"
      }
    }
  },
  "transitions": [
    {
      "source": "raw",
      "destination": "refining",
      "type": "claim",
      "label": "PM claims raw"
    },
    {
      "source": "refining",
      "destination": "duplicate",
      "type": "advance",
      "label": "PM marks duplicate"
    },
    {
      "source": "refining",
      "destination": "wont_fix",
      "type": "advance",
      "label": "PM marks won't-fix"
    },
    {
      "source": "refining",
      "destination": "consult_requested",
      "type": "advance",
      "label": "PM requests consult"
    },
    {
      "source": "consult_requested",
      "destination": "consulting",
      "type": "claim",
      "label": "consultant claims consult"
    },
    {
      "source": "consulting",
      "destination": "consult_complete",
      "type": "advance",
      "label": "consultant posts findings"
    },
    {
      "source": "consult_complete",
      "destination": "refining",
      "type": "claim",
      "label": "PM claims consult feedback"
    },
    {
      "source": "consulting",
      "destination": "spiking",
      "type": "advance",
      "label": "consultant requests spike sub-issue on inner-loop"
    },
    {
      "source": "spiking",
      "destination": "spike_returned",
      "type": "event",
      "label": "spike sub-issue completed (auto from inner-loop)"
    },
    {
      "source": "spike_returned",
      "destination": "consulting",
      "type": "claim",
      "label": "consultant claims to process spike findings"
    },
    {
      "source": "refining",
      "destination": "ready_for_dev",
      "type": "advance",
      "label": "PM marks ready (feat/bug/chore/exp)"
    },
    {
      "source": "ready_bounced",
      "destination": "refining",
      "type": "claim",
      "label": "PM claims bounced issue"
    },
    {
      "source": "refining",
      "destination": "deprioritized",
      "type": "advance",
      "label": "PM parks issue"
    },
    {
      "source": "ready_for_dev",
      "destination": "deprioritized",
      "type": "advance",
      "label": "PM parks issue"
    },
    {
      "source": "deprioritized",
      "destination": "refining",
      "type": "claim",
      "label": "PM claims to re-refine (staleness check)"
    },
    {
      "source": "deprioritized",
      "destination": "wont_fix",
      "type": "advance",
      "label": "PM kills parked issue"
    }
  ]
}
