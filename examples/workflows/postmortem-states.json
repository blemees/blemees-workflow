{
  "$schema": "../../docs/schemas/states.schema.json",
  "states": {
    "pending": {
      "class": "resting",
      "reversibility": "reversible-slow"
    },
    "drafting": {
      "class": "working",
      "roles": ["product-manager"],
      "issue_types": ["postmortem"]
    },
    "ready_for_followups": {
      "class": "resting",
      "reversibility": "reversible-fast"
    },
    "creating_followups": {
      "class": "working",
      "roles": ["product-manager"],
      "issue_types": ["postmortem"]
    },
    "complete": {
      "class": "terminal",
      "reversibility": "reversible-slow",
      "terminal_taxonomy": "resolved",
      "close_reason": "completed"
    }
  },
  "transitions": [
    {"source": "pending", "destination": "drafting", "type": "claim", "label": "PM claims postmortem"},
    {"source": "drafting", "destination": "ready_for_followups", "type": "advance", "label": "PM completes postmortem narrative"},
    {"source": "ready_for_followups", "destination": "creating_followups", "type": "claim", "label": "PM claims for follow-up filing"},
    {"source": "creating_followups", "destination": "complete", "type": "advance", "label": "PM files compensating issues (spawn events to process refinement)"}
  ]
}
