{
  "name": "postmortem",
  "canonical_catalog_path": "postmortem-hcps.json",
  "states": {
    "pending": {
      "class": "resting",
      "claim_role": "pm",
      "reversibility": "reversible-slow"
    },
    "drafting": {
      "class": "working"
    },
    "ready_for_followups": {
      "class": "resting",
      "claim_role": "pm"
    },
    "creating_followups": {
      "class": "working"
    },
    "complete": {
      "class": "terminal",
      "reversibility": "reversible-slow",
      "terminal_taxonomy": "resolved",
      "close_reason": "completed"
    }
  },
  "transitions": [
    {"source": "[*]", "destination": "pending", "type": "cross_process", "label": "from process incident-response (incident stabilized)", "kind": "spawn", "process": "incident-response"},

    {"source": "pending", "destination": "drafting", "type": "claim", "label": "PM claims postmortem"},
    {"source": "drafting", "destination": "ready_for_followups", "type": "role_action", "label": "PM completes postmortem narrative"},

    {"source": "ready_for_followups", "destination": "creating_followups", "type": "claim", "label": "PM claims for follow-up filing"},
    {"source": "creating_followups", "destination": "complete", "type": "role_action", "label": "PM files compensating issues (spawn events to process refinement)"}
  ]
}
