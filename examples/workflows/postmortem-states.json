{
  "$schema": "../../docs/schemas/states.schema.json",
  "group": "incident",
  "description": "Document the timeline, root cause, and remediation for an incident. Spawned by incident-response on stabilization; closes at `complete`. On close, the PM files bug/feature follow-ups on refinement and chore follow-ups on inner-loop via the closing-state spawn declaration.",
  "states": {
    "pending": {
      "class": "resting",
      "reversibility": "reversible-slow",
      "issue_types": [
        "postmortem"
      ]
    },
    "drafting": {
      "class": "working",
      "roles": [
        "product-manager"
      ],
      "issue_types": [
        "postmortem"
      ],
      "human_inputs": [
        "blocked-on-data",
        "needs-security-review",
        "general"
      ]
    },
    "complete": {
      "class": "resting",
      "reversibility": "reversible-slow",
      "spawns": [
        {
          "issue_type": "bug",
          "initial_state": "followup_requested"
        },
        {
          "process": "inner-loop",
          "issue_type": "chore",
          "initial_state": "ready_for_chore"
        },
        {
          "issue_type": "feature",
          "initial_state": "followup_requested"
        }
      ],
      "closes": {
        "taxonomy": "resolved",
        "reason": "completed"
      }
    }
  },
  "transitions": [
    {
      "source": "pending",
      "destination": "drafting",
      "type": "claim",
      "label": "PM claims postmortem"
    },
    {
      "source": "drafting",
      "destination": "complete",
      "type": "advance",
      "label": "PM closes postmortem (then files follow-ups on refinement)"
    }
  ]
}
