{
  "$schema": "../../docs/schemas/states.schema.json",
  "description": "The developer's day-to-day flow: claim a refined ticket, implement, open a PR, ship. Spawns a PR child issue and tracks staged/shipped state.",
  "states": {
    "ready_for_dev": {
      "class": "resting",
      "reversibility": "reversible-slow",
      "handoff": true
    },
    "ready_for_spike": {
      "class": "resting",
      "reversibility": "reversible-slow"
    },
    "ready_for_hotfix": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "handoff": true
    },
    "implementing": {
      "class": "working",
      "roles": [
        "developer"
      ],
      "issue_types": [
        "bug",
        "feature",
        "chore",
        "experiment",
        "hotfix"
      ],
      "spawns": {
        "process": "pr",
        "issue_type": "pr",
        "initial_state": "draft",
        "advance_on": {
          "merged": "staged"
        }
      },
      "human_inputs": [
        "clarify-scope",
        "needs-arch-review",
        "needs-security-review",
        "blocked-on-data",
        "general"
      ]
    },
    "implementing_spike": {
      "class": "working",
      "roles": [
        "developer"
      ],
      "issue_types": [
        "spike"
      ],
      "human_inputs": [
        "clarify-scope",
        "needs-arch-review",
        "general"
      ]
    },
    "staged": {
      "class": "resting",
      "reversibility": "reversible-slow"
    },
    "shipped": {
      "class": "terminal",
      "reversibility": "reversible-slow",
      "terminal_taxonomy": "shipped",
      "close_reason": "completed"
    },
    "spike_completed": {
      "class": "terminal",
      "reversibility": "reversible-fast",
      "terminal_taxonomy": "resolved",
      "close_reason": "completed"
    },
    "ready_bounced": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "handoff": true
    }
  },
  "transitions": [
    {
      "source": "ready_for_dev",
      "destination": "implementing",
      "type": "claim",
      "label": "developer claims issue"
    },
    {
      "source": "ready_for_spike",
      "destination": "implementing_spike",
      "type": "claim",
      "label": "developer claims spike"
    },
    {
      "source": "ready_for_hotfix",
      "destination": "implementing",
      "type": "claim",
      "label": "developer claims hotfix"
    },
    {
      "source": "implementing",
      "destination": "ready_bounced",
      "type": "advance",
      "label": "developer bounces ticket"
    },
    {
      "source": "implementing",
      "destination": "staged",
      "type": "advance",
      "label": "PR merged (auto from pr)"
    },
    {
      "source": "staged",
      "destination": "shipped",
      "type": "event",
      "label": "release shipped (auto from release)"
    },
    {
      "source": "implementing_spike",
      "destination": "spike_completed",
      "type": "advance",
      "label": "developer posts spike findings"
    }
  ]
}
