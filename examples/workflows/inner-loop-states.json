{
  "$schema": "../../docs/schemas/states.schema.json",
  "group": "delivery",
  "description": "The developer's day-to-day flow: claim a refined ticket, implement, open a PR. After merge, the ticket lands in `staged`, which is a shared handoff with `release` \u2014 from there the release process owns the lifecycle through to shipped. Spawns a PR child issue during implementing.",
  "states": {
    "ready_for_dev": {
      "class": "resting",
      "reversibility": "reversible-slow",
      "handoff": true,
      "initial": "engineer files chore directly (skips refinement)",
      "issue_types": [
        "bug",
        "feature",
        "chore",
        "experiment"
      ]
    },
    "ready_for_spike": {
      "class": "resting",
      "reversibility": "reversible-slow",
      "issue_types": [
        "spike"
      ]
    },
    "ready_for_hotfix": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "issue_types": [
        "hotfix"
      ]
    },
    "implementing": {
      "class": "working",
      "roles": [
        "developer"
      ],
      "issue_types": [
        "bug",
        "feature",
        "chore",
        "experiment",
        "hotfix"
      ],
      "spawns": {
        "process": "pr",
        "issue_type": "pr",
        "initial_state": "draft",
        "advance_on": {
          "merged": "staged"
        }
      },
      "human_inputs": [
        "clarify-scope",
        "needs-arch-review",
        "needs-security-review",
        "needs-ux-input",
        "blocked-on-data",
        "general"
      ]
    },
    "implementing_spike": {
      "class": "working",
      "roles": [
        "developer"
      ],
      "issue_types": [
        "spike"
      ],
      "human_inputs": [
        "clarify-scope",
        "needs-arch-review",
        "needs-security-review",
        "needs-ux-input",
        "blocked-on-data",
        "general"
      ]
    },
    "staged": {
      "class": "resting",
      "reversibility": "reversible-slow",
      "handoff": true,
      "issue_types": [
        "bug",
        "feature",
        "chore",
        "experiment",
        "hotfix"
      ]
    },
    "spike_completed": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "closes": {
        "taxonomy": "resolved",
        "reason": "completed"
      }
    },
    "ready_bounced": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "handoff": true,
      "issue_types": [
        "bug",
        "feature",
        "chore",
        "experiment"
      ]
    }
  },
  "transitions": [
    {
      "source": "ready_for_dev",
      "destination": "implementing",
      "type": "claim",
      "label": "developer claims issue"
    },
    {
      "source": "ready_for_spike",
      "destination": "implementing_spike",
      "type": "claim",
      "label": "developer claims spike"
    },
    {
      "source": "ready_for_hotfix",
      "destination": "implementing",
      "type": "claim",
      "label": "developer claims hotfix"
    },
    {
      "source": "implementing",
      "destination": "ready_bounced",
      "type": "advance",
      "label": "developer bounces ticket"
    },
    {
      "source": "implementing",
      "destination": "staged",
      "type": "advance",
      "label": "PR merged (auto from pr)"
    },
    {
      "source": "implementing_spike",
      "destination": "spike_completed",
      "type": "advance",
      "label": "developer posts spike findings"
    }
  ]
}
