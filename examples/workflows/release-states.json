{
  "$schema": "../../docs/schemas/states.schema.json",
  "group": "delivery",
  "description": "Cut, review, and ship a release train. Dev tickets (bug/feature/chore/experiment/hotfix) are handed off from `inner-loop.staged` and live here as contributors; a release ticket is created at `cut` (or `hotfix_cut`), collects the staged contributors, then runs review \u2192 deploy \u2192 released. On `released` the contributor tickets cascade to `shipped`; on `abandoned` / `rolled_back` they're returned to the queue for the next train.",
  "states": {
    "staged": {
      "class": "resting",
      "reversibility": "reversible-slow",
      "handoff": true,
      "issue_types": [
        "bug",
        "feature",
        "chore",
        "experiment",
        "hotfix"
      ]
    },
    "measuring": {
      "class": "resting",
      "reversibility": "reversible-slow",
      "handoff": true,
      "issue_types": [
        "experiment"
      ]
    },
    "cut": {
      "class": "resting",
      "reversibility": "reversible-slow",
      "issue_types": [
        "release"
      ],
      "collects": {
        "from_states": [
          "staged"
        ],
        "issue_types": [
          "bug",
          "feature",
          "chore",
          "experiment"
        ],
        "advance_on": {
          "released": {
            "experiment": "measuring",
            "*": "shipped"
          }
        },
        "release_on": [
          "abandoned",
          "rolled_back"
        ]
      }
    },
    "hotfix_cut": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "issue_types": [
        "release"
      ],
      "collects": {
        "from_states": [
          "staged"
        ],
        "issue_types": [
          "hotfix"
        ],
        "advance_on": {
          "released": "shipped"
        },
        "release_on": [
          "abandoned",
          "rolled_back"
        ]
      }
    },
    "preparing": {
      "class": "working",
      "roles": [
        "release-manager"
      ],
      "issue_types": [
        "release"
      ],
      "human_inputs": [
        "clarify-scope",
        "blocked-on-data",
        "general"
      ]
    },
    "ready_for_release_decision": {
      "class": "resting",
      "reversibility": "reversible-slow",
      "issue_types": [
        "release"
      ]
    },
    "reviewing_release": {
      "class": "working",
      "roles": [
        "product-owner"
      ],
      "issue_types": [
        "release"
      ],
      "human_inputs": [
        "needs-security-review",
        "blocked-on-data",
        "general"
      ]
    },
    "gated_nogo": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "issue_types": [
        "release"
      ]
    },
    "abandoning": {
      "class": "working",
      "roles": [
        "product-owner"
      ],
      "issue_types": [
        "release"
      ],
      "human_inputs": [
        "general"
      ]
    },
    "abandoned": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "closes": {
        "taxonomy": "abandoned",
        "reason": "not planned"
      }
    },
    "deploying": {
      "class": "resting",
      "reversibility": "reversible-slow",
      "issue_types": [
        "release"
      ]
    },
    "rolling_out": {
      "class": "resting",
      "reversibility": "reversible-slow",
      "issue_types": [
        "release"
      ]
    },
    "ready_for_monitoring": {
      "class": "resting",
      "reversibility": "reversible-slow",
      "issue_types": [
        "release"
      ]
    },
    "monitoring": {
      "class": "working",
      "roles": [
        "developer"
      ],
      "issue_types": [
        "release"
      ],
      "human_inputs": [
        "blocked-on-data",
        "general"
      ]
    },
    "rollback_requested": {
      "class": "resting",
      "reversibility": "reversible-fast",
      "issue_types": [
        "release"
      ]
    },
    "rolling_back": {
      "class": "working",
      "issue_types": [
        "release"
      ],
      "roles": [
        "incident-commander",
        "release-manager"
      ],
      "human_inputs": [
        "clarify-scope",
        "needs-arch-review",
        "blocked-on-data",
        "general"
      ]
    },
    "rolled_back": {
      "class": "resting",
      "reversibility": "reversible-slow",
      "closes": {
        "taxonomy": "reverted",
        "reason": "completed"
      }
    },
    "released": {
      "class": "resting",
      "reversibility": "reversible-slow",
      "closes": {
        "taxonomy": "shipped",
        "reason": "completed"
      }
    },
    "shipped": {
      "class": "resting",
      "reversibility": "reversible-slow",
      "closes": {
        "taxonomy": "shipped",
        "reason": "completed"
      }
    }
  },
  "transitions": [
    {
      "source": "cut",
      "destination": "preparing",
      "type": "claim",
      "label": "RM claims release train"
    },
    {
      "source": "hotfix_cut",
      "destination": "preparing",
      "type": "claim",
      "label": "IC / RM claims hotfix train"
    },
    {
      "source": "preparing",
      "destination": "ready_for_release_decision",
      "type": "advance",
      "label": "RM publishes release notes, tags release candidate"
    },
    {
      "source": "ready_for_release_decision",
      "destination": "reviewing_release",
      "type": "claim",
      "label": "PO claims train"
    },
    {
      "source": "reviewing_release",
      "destination": "gated_nogo",
      "type": "advance",
      "label": "PO defers with blocking reason"
    },
    {
      "source": "reviewing_release",
      "destination": "deploying",
      "type": "advance",
      "label": "PO approves go (or IC approves for patch train)"
    },
    {
      "source": "gated_nogo",
      "destination": "reviewing_release",
      "type": "claim",
      "label": "PO re-claims deferred train"
    },
    {
      "source": "gated_nogo",
      "destination": "abandoning",
      "type": "claim",
      "label": "PO claims to abandon train"
    },
    {
      "source": "abandoning",
      "destination": "abandoned",
      "type": "advance",
      "label": "PO closes train, issues revert to inner-loop.staged for next train"
    },
    {
      "source": "deploying",
      "destination": "rolling_out",
      "type": "event",
      "label": "production deploy completes (external \u2014 rollout starts)"
    },
    {
      "source": "rolling_out",
      "destination": "ready_for_monitoring",
      "type": "event",
      "label": "rollout reaches 100% (external monitoring signal)"
    },
    {
      "source": "ready_for_monitoring",
      "destination": "monitoring",
      "type": "claim",
      "label": "on-call claims post-deploy watch"
    },
    {
      "source": "monitoring",
      "destination": "released",
      "type": "advance",
      "label": "on-call confirms post-deploy window clean"
    },
    {
      "source": "monitoring",
      "destination": "rollback_requested",
      "type": "advance",
      "label": "on-call triggers rollback"
    },
    {
      "source": "rollback_requested",
      "destination": "rolling_back",
      "type": "claim",
      "label": "IC / RM claims rollback"
    },
    {
      "source": "rolling_back",
      "destination": "rolled_back",
      "type": "advance",
      "label": "rollback completes"
    }
  ]
}
