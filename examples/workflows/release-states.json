{
  "$schema": "../../docs/schemas/states.schema.json",
  "name": "release",
  "states": {
    "accumulating": {
      "class": "resting",
      "reversibility": "reversible-fast"
    },
    "cut": {
      "class": "resting",
      "reversibility": "reversible-slow"
    },
    "preparing": {
      "class": "working",
      "roles": ["release-manager"],
      "issue_types": ["release"]
    },
    "ready_for_release_decision": {
      "class": "resting",
      "reversibility": "reversible-slow"
    },
    "reviewing_release": {
      "class": "working",
      "roles": ["product-owner"],
      "issue_types": ["release"]
    },
    "gated_nogo": {
      "class": "resting",
      "reversibility": "reversible-fast"
    },
    "abandoning": {
      "class": "working",
      "roles": ["product-owner"],
      "issue_types": ["release"]
    },
    "abandoned": {
      "class": "terminal",
      "reversibility": "reversible-fast",
      "terminal_taxonomy": "abandoned",
      "close_reason": "not planned"
    },
    "deploying": {
      "class": "resting",
      "reversibility": "reversible-slow"
    },
    "rolling_out": {
      "class": "resting",
      "reversibility": "reversible-slow"
    },
    "ready_for_monitoring": {
      "class": "resting",
      "reversibility": "reversible-slow"
    },
    "monitoring": {
      "class": "working",
      "roles": ["developer"],
      "issue_types": ["release"]
    },
    "rolling_back": {
      "class": "working",
      "issue_types": ["release"],
      "roles": ["incident-commander", "release-manager"]
    },
    "rolled_back": {
      "class": "terminal",
      "reversibility": "reversible-slow",
      "terminal_taxonomy": "reverted",
      "close_reason": "completed"
    },
    "released": {
      "class": "terminal",
      "reversibility": "reversible-slow",
      "terminal_taxonomy": "shipped",
      "close_reason": "completed"
    }
  },
  "transitions": [
    {"source": "[*]", "destination": "accumulating", "type": "event", "label": "new train opens (on cadence, or after previous release closes)"},
    {"source": "accumulating", "destination": "cut", "type": "event", "label": "cadence timer elapses (time)"},
    {"source": "accumulating", "destination": "cut", "type": "event", "label": "RM triggers cut script"},
    {"source": "cut", "destination": "preparing", "type": "claim", "label": "RM claims train"},
    {"source": "preparing", "destination": "ready_for_release_decision", "type": "advance", "label": "RM publishes release notes, tags release candidate"},
    {"source": "ready_for_release_decision", "destination": "reviewing_release", "type": "claim", "label": "PO claims train"},
    {"source": "reviewing_release", "destination": "gated_nogo", "type": "advance", "label": "PO defers with blocking reason"},
    {"source": "reviewing_release", "destination": "deploying", "type": "advance", "label": "PO approves go (or IC approves for patch train)"},
    {"source": "gated_nogo", "destination": "reviewing_release", "type": "claim", "label": "PO re-claims deferred train"},
    {"source": "gated_nogo", "destination": "abandoning", "type": "claim", "label": "PO claims to abandon train"},
    {"source": "abandoning", "destination": "abandoned", "type": "advance", "label": "PO closes train, issues revert to inner-loop.staged for next train"},
    {"source": "deploying", "destination": "rolling_out", "type": "event", "label": "production deploy completes (external \u2014 progressive rollout starts)"},
    {"source": "rolling_out", "destination": "ready_for_monitoring", "type": "event", "label": "rollout reaches 100% (from process progressive-rollout)"},
    {"source": "ready_for_monitoring", "destination": "monitoring", "type": "claim", "label": "on-call claims post-deploy watch"},
    {"source": "monitoring", "destination": "released", "type": "advance", "label": "on-call confirms post-deploy window clean"},
    {"source": "monitoring", "destination": "rolling_back", "type": "advance", "label": "on-call triggers rollback"},
    {"source": "rolling_back", "destination": "rolled_back", "type": "advance", "label": "rollback completes"}
  ]
}
