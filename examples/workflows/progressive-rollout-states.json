{
  "$schema": "../../docs/schemas/states.schema.json",
  "description": "Gradually expand a flag-gated change across user cohorts while watching SLIs. Promotes through cohort tiers or aborts on regression.",
  "states": {
    "soaking": {
      "class": "resting",
      "reversibility": "reversible-slow"
    },
    "ready_for_stage_analysis": {
      "class": "resting",
      "reversibility": "reversible-fast"
    },
    "analyzing": {
      "class": "working",
      "roles": [
        "developer"
      ],
      "issue_types": [
        "release"
      ]
    },
    "holding": {
      "class": "resting",
      "reversibility": "reversible-fast"
    },
    "killing": {
      "class": "working",
      "issue_types": [
        "release"
      ],
      "roles": [
        "incident-commander",
        "incident-responder"
      ]
    },
    "complete": {
      "class": "terminal",
      "reversibility": "reversible-slow",
      "terminal_taxonomy": "shipped",
      "close_reason": "completed"
    },
    "kill_switched": {
      "class": "terminal",
      "reversibility": "reversible-slow",
      "terminal_taxonomy": "reverted",
      "close_reason": "completed"
    }
  },
  "transitions": [
    {
      "source": "soaking",
      "destination": "ready_for_stage_analysis",
      "type": "event",
      "label": "soak window elapses (time)"
    },
    {
      "source": "ready_for_stage_analysis",
      "destination": "analyzing",
      "type": "claim",
      "label": "on-call claims stage analysis"
    },
    {
      "source": "analyzing",
      "destination": "soaking",
      "type": "advance",
      "label": "on-call advances to next stage"
    },
    {
      "source": "analyzing",
      "destination": "complete",
      "type": "advance",
      "label": "on-call confirms final stage healthy"
    },
    {
      "source": "analyzing",
      "destination": "holding",
      "type": "advance",
      "label": "on-call pauses rollout"
    },
    {
      "source": "analyzing",
      "destination": "killing",
      "type": "advance",
      "label": "on-call claims to kill rollout"
    },
    {
      "source": "holding",
      "destination": "analyzing",
      "type": "claim",
      "label": "on-call re-claims held rollout"
    },
    {
      "source": "killing",
      "destination": "kill_switched",
      "type": "advance",
      "label": "on-call disables flag, files compensating bug"
    }
  ]
}
