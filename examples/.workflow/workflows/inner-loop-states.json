{
  "name": "inner-loop",
  "canonical_catalog_path": "inner-loop-hcps.json",
  "states": {
    "ready_for_dev": {
      "class": "resting",
      "claim_role": "developer",
      "reversibility": "reversible-slow"
    },
    "implementing": {
      "class": "working"
    },
    "staged": {
      "class": "resting",
      "claim_role": "developer"
    },
    "merging": {
      "class": "working"
    },
    "cancelling": {
      "class": "working"
    },
    "merged": {
      "class": "terminal",
      "reversibility": "reversible-slow",
      "terminal_taxonomy": "shipped",
      "close_reason": "completed"
    },
    "bounced_back": {
      "class": "terminal",
      "reversibility": "reversible-fast",
      "terminal_taxonomy": "iterated"
    },
    "abandoned_dev": {
      "class": "terminal",
      "reversibility": "reversible-fast",
      "terminal_taxonomy": "abandoned",
      "close_reason": "not planned"
    }
  },
  "transitions": [
    {
      "source": "[*]",
      "destination": "ready_for_dev",
      "type": "cross_process",
      "label": "from process refinement",
      "kind": "shared",
      "process": "refinement"
    },
    {
      "source": "ready_for_dev",
      "destination": "implementing",
      "type": "claim",
      "label": "developer claims ready_for_dev"
    },
    {
      "source": "implementing",
      "destination": "staged",
      "type": "role_action",
      "label": "developer opens PR"
    },
    {
      "source": "implementing",
      "destination": "bounced_back",
      "type": "role_action",
      "label": "developer bounces",
      "hitl": true,
      "gate": "bounce_back"
    },
    {
      "source": "staged",
      "destination": "implementing",
      "type": "claim",
      "label": "developer claims revisions"
    },
    {
      "source": "staged",
      "destination": "merging",
      "type": "claim",
      "label": "developer claims merge"
    },
    {
      "source": "merging",
      "destination": "merged",
      "type": "role_action",
      "label": "merge to main",
      "hitl": true,
      "gate": "merge_to_main"
    },
    {
      "source": "staged",
      "destination": "cancelling",
      "type": "claim",
      "label": "developer claims to cancel"
    },
    {
      "source": "cancelling",
      "destination": "abandoned_dev",
      "type": "role_action",
      "label": "developer abandons"
    }
  ]
}
