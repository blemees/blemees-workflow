{
  "name": "refinement",
  "canonical_catalog_path": "refinement-hcps.json",
  "issue_types": ["bug", "feature", "task"],
  "states": {
    "raw": {
      "class": "resting",
      "claim_role": "pm"
    },
    "refining": {
      "class": "working"
    },
    "ready_for_dev": {
      "class": "resting",
      "reversibility": "reversible-slow"
    },
    "wont_fix": {
      "class": "terminal",
      "reversibility": "reversible-fast",
      "terminal_taxonomy": "abandoned",
      "close_reason": "not planned"
    }
  },
  "transitions": [
    {
      "source": "[*]",
      "destination": "raw",
      "type": "external",
      "label": "issue created (external)"
    },
    {
      "source": "raw",
      "destination": "refining",
      "type": "claim",
      "label": "PM claims raw"
    },
    {
      "source": "refining",
      "destination": "ready_for_dev",
      "type": "role_action",
      "label": "PM marks ready",
      "hitl": true,
      "gate": "ready_for_dev"
    },
    {
      "source": "refining",
      "destination": "wont_fix",
      "type": "role_action",
      "label": "PM marks wont-fix",
      "hitl": true,
      "gate": "wont_fix"
    },
    {
      "source": "ready_for_dev",
      "destination": "[*]",
      "type": "cross_process",
      "label": "to process inner-loop",
      "kind": "shared",
      "process": "inner-loop"
    }
  ]
}
