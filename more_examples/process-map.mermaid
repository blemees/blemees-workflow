---
title: Process Map
config:
    layout: elk
---
flowchart LR

    RAW([raw issue]):::entry
    PAGE([page / alert]):::entry
    PRIO[/prioritization<br/>overlay/]:::overlay

    subgraph BUILD["🔨 Build"]
        direction TB
        REFINE(refinement)
        DEV(inner-loop)
        PRp(pr)
    end

    subgraph SHIP["🚀 Ship"]
        direction TB
        REL(release)
        ROLL(progressive-rollout)
    end

    subgraph RESPOND["🚨 Respond"]
        direction TB
        IR(incident-response)
        MIT(mitigation)
        BP(backport)
        PM(postmortem)
    end

    subgraph LEARN["🔬 Learn"]
        direction TB
        EXP(experimentation)
    end

    %% Primary build → ship path (thick)
    RAW ==> REFINE
    REFINE ==>|ready_for_dev / exp / spike| DEV
    DEV ==>|spawn PR| PRp
    PRp ==>|staged| DEV
    DEV ==>|staged| REL
    REL ==>|flag-gated rollout| ROLL

    %% Incident path
    PAGE ==> IR
    IR ==>|spawn mitigation| MIT
    IR ==>|spawn backport per branch| BP
    IR ==>|stabilized, spawn postmortem| PM

    %% Mitigation + backport reuse build / ship rails
    MIT -->|ready_for_hotfix| DEV
    MIT -->|hotfix release| REL
    BP -->|backport PR| PRp
    BP -->|patch release| REL

    %% Feedback (dashed)
    DEV -.->|ready_bounced| REFINE
    PM -.->|follow-up issues| REFINE
    REL -.->|experiment merged<br/>spawn measurement| EXP
    EXP -.->|iterate / promote cleanup| REFINE

    %% Prioritization overlay (dashed)
    PRIO -.->|rank queue| REFINE
    PRIO -.->|committed batch| DEV

    %% Styling
    classDef entry fill:#f6f8fa,stroke:#57606a,stroke-width:1px,color:#24292f
    classDef overlay fill:#fff8c5,stroke:#bf8700,stroke-width:1px,stroke-dasharray:5 5,color:#24292f

    %% Legend (as a note-equivalent comment for readers)
    %% Thick (==>)  : primary happy-path handoff
    %% Thin  (-->)  : secondary or conditional handoff (hotfix, backport)
    %% Dashed(-.->): feedback loop or overlay effect
    %% Edge labels name the shared resting state OR the spawn action.
    %% For full state-level detail, see the per-process *-lifecycle.mermaid files.
